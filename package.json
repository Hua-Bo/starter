{
  "name": "vue-vite-starter",
  "version": "1.0.0",
  "description": "Vue 3 + Vite + TypeScript 项目模板，内置 GitHub Pages 与 Cloudflare Workers 自动部署",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run build",
    "cf:build": "bash ./cloudflare-build.sh",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "pinia": "^3.0.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.7.0",
    "sass": "^1.83.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.0.0"
  }
}
