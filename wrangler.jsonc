{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker 名称（全局唯一），部署前请改为你的项目名
  "name": "vue-vite-starter",

  // Worker 入口文件
  "main": "workers/api.ts",

  // Workers 运行时兼容日期，影响可用 API
  "compatibility_date": "2026-07-22",

  // 静态资源托管配置
  "assets": {
  // 构建产物目录（npm run build 输出）
    "directory": "./dist",
    // SPA 模式：未匹配文件时返回 index.html
    "not_found_handling": "single-page-application",
    // 绑定名称，对应 workers/api.ts 中 env.ASSETS
    "binding": "ASSETS",
    // 以下路径优先由 Worker 处理，其余走静态资源
    "run_worker_first": ["/api/*"]
  }
}
