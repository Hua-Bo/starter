{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vue-vite-starter",
  "main": "workers/api.ts",
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
